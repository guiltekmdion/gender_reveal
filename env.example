# Configuration pour Gender Reveal App
# Copiez ce fichier en .env et modifiez les valeurs selon vos besoins

# Port d'exposition de l'application (par défaut: 3000)
PORT=3000

# Mot de passe administrateur (changez-le en production!)
ADMIN_PASSWORD=admin123

# Secret JWT pour l'authentification (changez-le en production!)
# Générez un secret fort avec: openssl rand -base64 32
JWT_SECRET=change-this-secret-key

# URL publique de l'application
# En production, remplacez par votre domaine: https://votre-domaine.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Type de stockage: 'file' ou 'database'
STORAGE_TYPE=file

# Chemin vers la base de données (si STORAGE_TYPE=database)
DATABASE_PATH=./data/gender_reveal.db
